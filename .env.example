# Copy to .env.local for development. Set the same variables in Vercel → Project → Settings → Environment Variables.
#
# Only VITE_* variables are bundled into the browser. Put ONLY public values here.
# NEVER add the Supabase service-role key, database password or JWT secret to this project.

# Supabase project URL (Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (safe for browsers; access is enforced by Row Level Security)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical public URL of the deployed site, without a trailing slash.
# Used in QR codes on ID cards, canonical links, sitemap.xml and auth email redirects.
VITE_PUBLIC_SITE_URL=https://your-project.vercel.app
